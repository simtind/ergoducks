if SHIELD_ERGODUCKS_LEFT

config ZMK_KEYBOARD_NAME
    default "ergoducks"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif # SHIELD_ERGODUCKS_LEFT

if SHIELD_ERGODUCKS_LEFT || SHIELD_ERGODUCKS_RIGHT

config ZMK_SPLIT
    default y

if ZMK_RGB_UNDERGLOW

    config WS2812_STRIP_I2S
        default y

endif

if EC11

    config EC11_TRIGGER_GLOBAL_THREAD
        default y

endif

if ZMK_DISPLAY

    config I2C
        default y

    config SSD1306
        default y

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # LVGL

endif # SHIELD_ERGODUCKS_LEFT || SHIELD_ERGODUCKS_RIGHT
